                              ],
                              [
                                "ProcessPlanType",
                                {
                                  "Name": "ProcessPlanType",
                                  "ClassName": "cmas.ontology.processplan.ProcessPlan",
                                  "Description": "Type of process plan",
                                  "CanInherit": false,
                                  "Override": true,
                                  "ReadOnly": true,
                                  "ParentID": "",
                                  "PropertyType": "[INHERITANCE]",
                                  "LocalValue": "STRUCTUREDTEXT"
                                }
                              ],
                              [
                                "Cost",
                                {
                                  "Name": "Cost",
                                  "ClassName": "cmas.ontology.processplan.ProcessPlan",
                                  "Description": "The cost to execute the process plan, can be used for optimisation.",
                                  "CanInherit": true,
                                  "Override": true,
                                  "ReadOnly": false,
                                  "ParentID": "",
                                  "PropertyType": "[INHERITANCE]",
                                  "LocalValue": "0"
                                }
                              ],
                              [
                                "PostAction",
                                {
                                  "Name": "PostAction",
                                  "ClassName": "cmas.ontology.processplan.ProcessPlan",
                                  "Description": "An action to be execute after the process plan is done.",
                                  "CanInherit": true,
                                  "Override": true,
                                  "ReadOnly": false,
                                  "ParentID": "",
                                  "PropertyType": "[INHERITANCE]",
                                  "LocalValue": "NONE"
                                }
                              ],
                              [
                                "TargetType",
                                {
                                  "Name": "TargetType",
                                  "ClassName": "cmas.ontology.processplan.ProcessPlan",
                                  "Description": "A target type of the process plan.",
                                  "CanInherit": true,
                                  "Override": true,
                                  "ReadOnly": false,
                                  "ParentID": "",
                                  "PropertyType": "[STRINGEDIT, MODELLING]",
                                  "LocalValue": ""
                                }
                              ],
                              [
                                "Actions",
                                {
                                  "Name": "Actions",
                                  "ClassName": "cmas.ontology.processplan.ProcessPlanStructuredText",
                                  "Description": "Process plan actions",
                                  "CanInherit": true,
                                  "Override": true,
                                  "ReadOnly": false,
                                  "ParentID": "",
                                  "PropertyType": "[TEXTEDITOR]",
                                  "LocalValue": "Program sMove;\n\nfunction onRun() : integer;\nvar srcX, dstX : integer;\nvar arrived : boolean;\nbegin\n    srcX := interface.sourceX;\n    dstX := interface.destX;\n    \n    writeln('Crane: Starting move. Pick from X=', srcX, ' Place at X=', dstX);\n    \n    (* Step 1: Release vacuum *)\n    agent.vacuum := 0;\n    Sleep(300);\n    \n    (* Step 2: Rise to travel height Y=200 *)\n    agent.setY := 200;\n    arrived := false;\n    while not arrived do begin\n        if abs(agent.posY - 200) < 10 then\n            arrived := true;\n        Sleep(100);\n    end;\n    \n    (* Step 3: Move in X to source position *)\n    agent.setX := srcX;\n    arrived := false;\n    while not arrived do begin\n        if abs(agent.posX - srcX) < 10 then\n            arrived := true;\n        Sleep(100);\n    end;\n    \n    (* Step 4: Descend to pick height Y=82 *)\n    agent.setY := 82;\n    arrived := false;\n    while not arrived do begin\n        if abs(agent.posY - 82) < 10 then\n            arrived := true;\n        Sleep(100);\n    end;\n    \n    (* Step 5: Grip the part *)\n    agent.vacuum := 1;\n    Sleep(500);\n    \n    (* Step 6: Rise back to travel height *)\n    agent.setY := 200;\n    arrived := false;\n    while not arrived do begin\n        if abs(agent.posY - 200) < 10 then\n            arrived := true;\n        Sleep(100);\n    end;\n    \n    (* Step 7: Move in X to destination position *)\n    agent.setX := dstX;\n    arrived := false;\n    while not arrived do begin\n        if abs(agent.posX - dstX) < 10 then\n            arrived := true;\n        Sleep(100);\n    end;\n    \n    (* Step 8: Descend to place height Y=82 *)\n    agent.setY := 82;\n    arrived := false;\n    while not arrived do begin\n        if abs(agent.posY - 82) < 10 then\n            arrived := true;\n        Sleep(100);\n    end;\n    \n    (* Step 9: Release part *)\n    agent.vacuum := 0;\n    Sleep(300);\n    \n    (* Step 10: Rise back to travel height *)\n    agent.setY := 200;\n    arrived := false;\n    while not arrived do begin\n        if abs(agent.posY - 200) < 10 then\n            arrived := true;\n        Sleep(100);\n    end;\n    \n    writeln('Crane: Move complete');\n    onRun := processplan.done;\nend."
                                }
                              ]
                            ],
                            "Relations": [
                              [
                                "Requirements"
                              ],
                              [
                                "Hazards"
                              ]
                            ],
                            "EntityType": "PROCESSPLAN",
                            "ProcessPlanType": "STRUCTUREDTEXT"
                          }
                        ]
                      ],
                      "EntityType": "INTERFACE"
