                    "Actions",
                    {
                      "Name": "Actions",
                      "ClassName": "cmas.ontology.agents.AgentAction",
                      "Description": "User defined actions",
                      "CanInherit": true,
                      "Override": true,
                      "ReadOnly": false,
                      "ParentID": "",
                      "PropertyType": "[TEXTEDITOR, MODELLING]",
                      "LocalValue": "program Source2;\n\nvar deployed : boolean;\n\nprocedure onDeploy;\nbegin\n    deployed := false;\n    agent.locationX := 158;\n    writeln('Source2: Ready. locationX=', agent.locationX);\nend.\n\nprocedure Running;\nbegin\n    Sleep(500);\n    if agent.sensor = 0 then begin\n        deployed := false;\n    end;\n    if (agent.sensor = 1) and (not deployed) then begin\n        writeln('Source2: Part detected. Deploying Part2...');\n        Sleep(500);\n        if deploybyname('Part2') then begin\n            deployed := true;\n            writeln('Source2: Part2 deployed');\n        end;\n    end;\nend."
                    }
                  ],
